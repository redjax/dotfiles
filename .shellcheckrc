# ShellCheck configuration for this repository.
#
# Shell scripts generated by chezmoi are checked after rendering, so
# template-related parser warnings are only relevant to the source scan.

disable=SC1054
disable=SC1072
disable=SC1073
disable=SC1083

# Dotfiles commonly define variables that are consumed by another shell,
# plugin, or framework.
disable=SC2034

# ShellCheck cannot follow dynamic source paths used by some dotfiles.
disable=SC1090

# Some zsh aliases intentionally use patterns that ShellCheck flags.
disable=SC2142
disable=SC2139

# Some zsh files do not contain a shebang because they are sourced by zsh.
disable=SC2148
